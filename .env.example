# ====== STEP 1: DATABASE (free, 5 min) ======
# 1. Go to https://www.mongodb.com/cloud/atlas/register and create a FREE account
# 2. Create a FREE cluster (M0, region: Mumbai/ap-south-1, name anything)
# 3. Click "Database Access" → Add New User → username + password (SAVE THESE)
# 4. Click "Network Access" → Add IP → "Allow access from anywhere" → Confirm
# 5. Click "Database" → your cluster → "Connect" → "Drivers" → copy the connection string
#    It looks like:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/
# 6. Paste it below. IMPORTANT: add /the-store  at the end (before the ?)
#    Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/the-store?retryWrites=true&w=majority

MONGODB_URI=

# ====== STEP 2: ADMIN LOGIN PASSWORD ======
# Password you will type at /admin on your site. Choose 8+ characters.
ADMIN_PASSWORD=

# ====== YOUR HOST EMAIL ======
# The email that unlocks "Add/Remove product" & "Offers" buttons on your site.
# Only this email gets host powers; all other emails are normal customers.
HOST_EMAIL=sjohnpaul638@gmail.com

# Extra secret for login security (optional — any long random string)
ADMIN_SECRET=please-change-me-to-something-random

# ====== STEP 3: AI CHATBOT (free, optional) ======
# 1. Go to https://aistudio.google.com/apikey and click "Create API key" (free, Google account)
# 2. Paste the key below. If you leave it empty, the chatbot still works with simple
#    pre-written answers (no AI).
GEMINI_API_KEY=

# ====== STEP 4: ONLINE PAYMENTS (optional — store works without them) ======
# Without these, customers can still pay via Direct UPI (manual verification)
# and Cash on Delivery. Add EITHER gateway (or both) to enable online payments
# at checkout. Keys appear in /admin → Settings when configured.

# --- Razorpay (UPI + cards + netbanking, best for India) ---
# 1. Sign up at https://razorpay.com → Dashboard → Settings → API Keys → Generate Key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (optional but recommended): Dashboard → Settings → Webhooks
#   URL: https://your-domain.com/api/payments/webhook   Events: payment.captured
RAZORPAY_WEBHOOK_SECRET=

# --- Stripe (international cards) ---
# 1. Sign up at https://dashboard.stripe.com/register → Developers → API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook secret (optional but recommended): Developers → Webhooks
#   URL: https://your-domain.com/api/payments/webhook   Events: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# Public URL of the deployed site (used for Stripe payment redirects).
# For local testing: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ====== STEP 5: SHIPPING PROVIDER (optional) ======
# Auto-create shipments & tracking numbers. Leave empty for manual tracking
# (you type the courier + tracking number in /admin → Orders).
# Valid values: shiprocket | amazon-shipping | (empty = manual)

SHIPPING_PROVIDER=

# --- Shiprocket (https://shiprocket.in) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=

# --- Amazon Shipping (Seller Central shipping services app) ---
AMAZON_SHIPPING_CLIENT_ID=
AMAZON_SHIPPING_CLIENT_SECRET=
AMAZON_SHIPPING_REFRESH_TOKEN=
AMAZON_SELLING_PARTNER_ROLE_ARN=

# ====== STEP 6: AUTOMATED WHATSAPP & SMS NOTIFICATIONS (optional) ======
# Sends automated order confirmation, packing, shipping, and delivery updates.
# If left empty, all notifications safely log to server console for testing.
# Valid values: both | whatsapp | sms (default: both)
NOTIFICATION_CHANNEL=both

# --- Option A: Twilio (Global SMS & WhatsApp) ---
# Sign up at https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# --- Option B: MSG91 (India DLT SMS) ---
# Sign up at https://msg91.com
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MJFSHN

# --- Option C: Custom Webhook (AiSensy, Wati, Interakt, Zapier, Make) ---
NOTIFICATION_WEBHOOK_URL=